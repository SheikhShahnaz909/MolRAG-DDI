# Copy to .env (never commit the real .env).
MONGO_URI=
JWT_SECRET=                 # same value as otp-backend/.env

# Optional
CORS_ORIGINS=*              # production: your frontend address, e.g. https://molrag-ddi.vercel.app
SIDE_EFFECTS_EXTERNAL=1     # 0 = never call outside services (offline demos)
OPENFDA_API_KEY=            # free key from open.fda.gov raises the daily request limit
SIDE_EFFECTS_TIMEOUT=6      # seconds to wait for each outside request
